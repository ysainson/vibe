{
  "version": 1,
  "patterns": [
    { "name": "aws-access-key", "regex": "AKIA[0-9A-Z]{16}" },
    { "name": "gcp-api-key", "regex": "AIza[0-9A-Za-z_-]{35}" },
    { "name": "github-token", "regex": "gh[pousr]_[A-Za-z0-9]{36,}" },
    { "name": "openai-key", "regex": "sk-(proj-)?[A-Za-z0-9_-]{20,}" },
    { "name": "anthropic-key", "regex": "sk-ant-[A-Za-z0-9_-]{20,}" },
    { "name": "private-key-block", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----" },
    { "name": "bearer-token", "regex": "[Bb]earer\\s+[A-Za-z0-9._~+/=-]{20,}" }
  ]
}
